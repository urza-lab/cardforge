# CardForge environment configuration.
# Copy this file to .env and adjust as needed: cp .env.example .env
#
# Secrets (DB password, app secret key, Grafana admin password) are NOT set
# here by default. If left unset, the `secrets-init` service generates them
# once on first startup and persists them under ./data/secrets/ — see
# SECURITY.md. Set them here only if you need a specific value (e.g. to
# match an externally managed password).
# POSTGRES_PASSWORD=
# DB_PASSWORD=
# APP_SECRET_KEY=
# GRAFANA_ADMIN_PASSWORD=

# --- Host / networking ---
CARDFORGE_HOST_PORT=666

# --- Postgres ---
POSTGRES_DB=cardforge
POSTGRES_USER=cardforge

# --- App ---
CARDFORGE_ENVIRONMENT=production
CARDFORGE_LOG_LEVEL=INFO
# single-user-no-login | multi-user
CARDFORGE_AUTH_MODE=single-user-no-login
CARDFORGE_DEFAULT_LOCALE=en

# --- Scryfall ---
# Auto-download Scryfall bulk data on first start (shows progress in the UI).
# Set to false to trigger the bulk import manually instead (System Status page).
CARDFORGE_SCRYFALL_BULK_AUTO_DOWNLOAD=true

# --- Grafana (optional, see docker-compose.yml `grafana`/`prometheus` services) ---
GRAFANA_HOST_PORT=3000

# --- Data directory on the host (bind mount root) ---
CARDFORGE_DATA_DIR=./data
