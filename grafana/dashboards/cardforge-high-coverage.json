{
  "title": "CardForge — High-Coverage Decks",
  "uid": "cardforge-high-coverage",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["cardforge"],
  "templating": {
    "list": [
      {
        "name": "app_base_url",
        "type": "textbox",
        "label": "CardForge base URL",
        "description": "Where this Grafana instance can reach the CardForge web UI - used for the deck/cube links below. Change this if your CardForge isn't at the default LXC address.",
        "query": "http://docker.trusted.local:666",
        "current": { "value": "http://docker.trusted.local:666", "text": "http://docker.trusted.local:666" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Decks & cubes by buildability coverage",
      "description": "Which decks/cubes are closest to (or already) fully buildable from your collection - click a name to open it in CardForge. See app.metrics.prometheus_exporter's cardforge_list_coverage_percent gauge.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "cardforge_list_coverage_percent", "instant": true, "format": "table", "refId": "A" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "indexByName": {},
            "renameByName": { "list_id": "list_id", "list_name": "Deck / Cube", "list_type": "Type", "Value": "Coverage %" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Coverage %", "desc": true }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "list_id" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Deck / Cube" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in CardForge",
                    "url": "${app_base_url}/lists/${__data.fields.list_id}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Coverage %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": 0 },
                    { "color": "yellow", "value": 50 },
                    { "color": "green", "value": 90 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 2,
      "type": "xychart",
      "title": "Coverage vs. cost to complete",
      "description": "Each point is one deck/cube: how close it already is to buildable (x) against the real market cost of everything still missing (y, default price profile - see PRICING.md). The bottom-right corner (high coverage, low cost) is the best bang-for-buck to finish next. A deck is only plotted once every missing card actually resolved a price - see cardforge_list_missing_cost's own doc string for why a partial total is omitted rather than shown too low.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "cardforge_list_coverage_percent", "instant": true, "format": "table", "refId": "A" },
        { "expr": "cardforge_list_missing_cost", "instant": true, "format": "table", "refId": "B" }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "list_id", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true, "__name__ 1": true, "__name__ 2": true,
              "instance 1": true, "instance 2": true, "job 1": true, "job 2": true,
              "list_name 2": true, "list_type 2": true
            },
            "indexByName": {},
            "renameByName": {
              "list_name 1": "Deck / Cube", "list_type 1": "Type",
              "Value #A": "Coverage %", "Value #B": "Missing Cost", "currency": "Currency"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "pointSize": { "fixed": 8 } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Coverage %" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }] },
          { "matcher": { "id": "byName", "options": "Missing Cost" }, "properties": [{ "id": "unit", "value": "currencyUSD" }] }
        ]
      },
      "options": {
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      }
    }
  ]
}
