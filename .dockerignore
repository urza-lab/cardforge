# Build context for backend/Dockerfile is the repo root (see docker-compose.yml).
# Keep runtime data — including ./data/secrets, which holds real secrets once
# the stack has run once — out of the build context entirely: nothing here is
# ever COPYed into an image, but there is no reason to even send it to the
# Docker daemon.
/data/
.git/
.github/

# Frontend (irrelevant to the backend image; frontend/Dockerfile uses its own
# context: ./frontend, so this only matters for the backend/worker/secrets-init
# builds)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python
**/__pycache__/
*.pyc
backend/.venv/
backend/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

*.log
.vscode/
.idea/
